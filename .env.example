# Copy to .env.local and fill in. Every variable is optional: the site runs
# without them, degrading gracefully (contact form logged to the console,
# no password gate).

# Resend — delivery for contact-form enquiries. Without it, submissions are
# logged to the server console instead of emailed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile — spam protection on the contact form.
# Only enforced when the secret is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Pre-launch password gate. Unset means the site is public.
SITE_PASSWORD=
SITE_AUTH_SECRET=
